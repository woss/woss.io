{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "enabled": true,
  },
  "tasks": {
    "build": {
      // Turbo v2 strict env mode strips undeclared vars from tasks; the
      // prerender hardens the logger and requires DD_API_KEY at build time.
      "env": [
        "DD_API_KEY"
      ],
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "svelte.config.js",
        "vite.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "build/**",
        ".svelte-kit/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": [
        "tmp/**"
      ],
      "inputs": [
        "src/**"
      ],
    },
    "check": {},
    "build-index": {},
    "fmt:check": {}
  }
}
